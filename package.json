{
  "name": "simple-editorial",
  "version": "1.0.0",
  "description": "Speed up manuscript review with automatic comments and editorial styling.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/editorial-core.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "editorial",
    "comments",
    "writing"
  ],
  "author": "Beppe",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
